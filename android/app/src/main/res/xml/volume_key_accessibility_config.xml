<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for the volume-key accessibility service.

  canRequestFilterKeyEvents: required to receive key events via onKeyEvent().
  accessibilityEventTypes / accessibilityFeedbackType are kept minimal because
  we only care about key events, not screen content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagDefault"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/volume_key_service_description"
    android:notificationTimeout="100" />
